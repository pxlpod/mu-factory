# Supabase — project `mindless-mu` (ref bfvrekckhuifncagccqx).
# Dashboard: https://supabase.com/dashboard/project/bfvrekckhuifncagccqx/settings/api
# This app only ever touches schema `mu` and bucket `mu-media`.
SUPABASE_URL=https://bfvrekckhuifncagccqx.supabase.co
# Same page, the `service_role` secret. Server-only; never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Monday personal API token.
# Monday → your avatar (bottom left) → Developer → My access tokens → Show.
MONDAY_API_TOKEN=
# Item id that receives alerts when no episode is known (any item on the
# Publishing board works — a pinned "MU Factory alerts" item is the idea).
# From the item's URL: …/boards/18426983206/pulses/<this number>.
MONDAY_ALERT_ITEM_ID=

# Google service account key, base64 of the whole downloaded .json file.
#   base64 -i ~/Downloads/mu-factory-xxxx.json | pbcopy
# The service account must be shared onto the MU root Drive folder (Viewer is enough).
GOOGLE_SERVICE_ACCOUNT_JSON=
# The MU root folder id, from its Drive URL. `Covers/yt` lives under it.
DRIVE_ROOT_FOLDER_ID=

# Google OAuth 2.0 client (Web application) for YouTube.
# Google Cloud → APIs & Services → Credentials → the OAuth client → Client ID / secret.
# Authorised redirect URI must be exactly ${APP_URL}/google/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The deployed origin, no trailing slash. Used to build the OAuth redirect URI.
APP_URL=https://mu-factory.vercel.app

# Zernio. API key from the Zernio dashboard (Settings → API). The webhook
# secret is generated when you register ${APP_URL}/api/webhooks/zernio there.
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=

# Any long random string. Vercel Cron sends it as `Authorization: Bearer …`.
#   openssl rand -hex 32
CRON_SECRET=

# The single password for /status. Your choice; nothing else uses it.
APP_PASSWORD=

# Optional, local only. A Chromium binary for scripts/check-studio.ts and a
# local `next dev`; Vercel never sets it and uses the bundled @sparticuz/chromium.
#   macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROMIUM_EXECUTABLE_PATH=
